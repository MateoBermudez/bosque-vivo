# Copia este archivo a .env.local y completa los valores. .env.local NO se sube a git.

# --- Origen de datos ---------------------------------------------------------
# mock = datos de ejemplo (no necesita backend). live = API real de Bosque Vivo.
BV_DATA_SOURCE=mock

# Solo en modo live ------------------------------------------------------------
BACKEND_URL=http://127.0.0.1:8000
# Mismo valor que ADMIN_TOKEN del backend. Solo lo usa el servidor de este sitio
# (chat y trazas); nunca lleva el prefijo NEXT_PUBLIC_.
ADMIN_TOKEN=
# 1 = forzar el aviso "datos ilustrativos". En modo live sale solo si hay proyectos del registro «demo».
BV_SAMPLE_NOTICE=0

# --- Área de auditores (chat y trazas) ---------------------------------------
# Sin estas dos variables el área queda abierta en desarrollo y BLOQUEADA en producción.
AUDITOR_ACCESS_CODE=
# Cadena aleatoria larga para firmar la sesión. Genera una con: openssl rand -hex 32
SESSION_SECRET=

# --- Opcionales --------------------------------------------------------------
# Número del asistente de WhatsApp, solo dígitos con indicativo de país (p. ej. 573001234567).
WHATSAPP_PUBLIC_NUMBER=
# URL pública del sitio (para metadatos).
SITE_URL=http://localhost:3000
# Mosaicos del mapa (por defecto CARTO oscuro). Formato: https://servidor/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILES_URL=
