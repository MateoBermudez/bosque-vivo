APP_ENV=dev
DATABASE_URL=sqlite:///data/bosquevivo.db
DATA_DIR=data
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MODEL_LIGHT=
GEE_PROJECT=
# gee = Earth Engine (NDVI Sentinel-2/Landsat + pérdida) | open = MODIS 250 m + Hansen, datos abiertos sin cuenta
# hansen = solo pérdida de bosque | fake = pruebas
SATELLITE_PROVIDER=gee
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
PHONE_HMAC_KEY=
ADMIN_TOKEN=
# Solo estos teléfonos (separados por coma, formato internacional sin +) usan el asistente; vacío = todos
WHATSAPP_ALLOWED_PHONES=
# Umbral de nubosidad por escena (%) para filtrar imágenes Sentinel-2/Landsat (RF02)
CLOUD_MAX_PERCENT=20
# Cuentas de auditor (RF09): URL pública del sitio para el enlace de restablecimiento
WEB_BASE_URL=http://localhost:3000
PASSWORD_RESET_TTL_MINUTES=30
# outbox = guarda los correos como .eml en data/outbox (desarrollo) | smtp = envío real
MAIL_BACKEND=outbox
MAIL_FROM=Bosque Vivo <no-responder@bosquevivo.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
