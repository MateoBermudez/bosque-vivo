APP_ENV=dev
# Base de datos. Local: SQLite. Producción (Vercel): Supabase, cadena del «Transaction pooler»
# (Connect > Transaction pooler), p. ej.
# DATABASE_URL=postgresql://postgres.<ref>:[YOUR-PASSWORD]@aws-0-<región>.pooler.supabase.com:6543/postgres
# y la contraseña aparte, que reemplaza [YOUR-PASSWORD]:
# DATABASE_PASSWORD=
DATABASE_URL=sqlite:///data/bosquevivo.db
DATABASE_PASSWORD=
DATA_DIR=data
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MODEL_LIGHT=
GEE_PROJECT=
# open = MODIS 250 m + Hansen, datos abiertos sin cuenta (por defecto) | gee = Earth Engine (requiere GEE_PROJECT)
# hansen = solo pérdida de bosque | fake = pruebas
SATELLITE_PROVIDER=open
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Versión de la API de Meta (Graph). Actualícela si Meta la retira: developers.facebook.com/docs/graph-api/changelog
WHATSAPP_API_VERSION=v25.0
PHONE_HMAC_KEY=
ADMIN_TOKEN=
# Solo estos teléfonos (separados por coma, formato internacional sin +) usan el asistente; vacío = todos
WHATSAPP_ALLOWED_PHONES=
# Umbral de nubosidad por escena (%) para filtrar imágenes Sentinel-2/Landsat (RF02)
CLOUD_MAX_PERCENT=20
# Cuentas de auditor (RF09): URL pública del sitio para los enlaces de los correos
WEB_BASE_URL=http://localhost:3000
PASSWORD_RESET_TTL_MINUTES=30
INVITATION_TTL_HOURS=72
# Correo. auto = SMTP si SMTP_USER y SMTP_PASSWORD están llenos; si no, guarda los .eml en data/outbox
# Para Gmail o Outlook basta SMTP_USER y SMTP_PASSWORD (contraseña de aplicación): el servidor se detecta solo
MAIL_BACKEND=auto
MAIL_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
# Verificación en dos pasos por correo: auto = activa cuando hay SMTP | on | off
AUTH_TWO_FACTOR=auto
AUTH_CODE_TTL_MINUTES=10
# Aviso por correo de cada inicio de sesión nuevo
AUTH_LOGIN_ALERTS=true
